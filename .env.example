# 小荷包报销助手 环境配置示例
# 复制为 .env 后按需修改

# OpenAI 兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OCR（PaddleOCR）。未安装 PaddleOCR 时可设为 false 仅使用其他功能
OCR_ENABLED=true
OCR_LANG=ch

# 审批流机器人（群机器人 Webhook，二选一或都配）
# 钉钉自定义机器人：安全设置选「加签」时同时填 DINGTALK_SECRET
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 企业微信群机器人
WECOM_WEBHOOK=

# 跨域，多个用逗号分隔
CORS_ORIGINS=*

# 上传大小上限（MB）
MAX_UPLOAD_MB=20
